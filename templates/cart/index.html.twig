{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
    <h1 class="section-title">Mon panier</h1>

    {% if items is empty %}
        <p>Votre panier est vide.</p>
    {% else %}
        <ul class="cart-list">
            {% for item in items %}
                <li class="cart-item">
                    <img src="{{ asset('images/products/' ~ (item.product.image ?? 'placeholder.png')) }}" alt="Sweat-shirt {{ item.product.name }}" width="120" height="150">
                    <div class="cart-item-info">
                        <p><span class="label">Nom</span> {{ item.product.name }}</p>
                        <p><span class="label">Prix</span> {{ item.product.price|euros }}{% if item.quantity > 1 %} &times; {{ item.quantity }}{% endif %}</p>
                        <p><span class="label">Taille</span> {{ item.size.value }}</p>
                    </div>
                    <form method="post" action="{{ path('app_cart_remove', {id: item.product.id, size: item.size.value}) }}" class="cart-item-action">
                        <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.product.id ~ '_' ~ item.size.value) }}">
                        <button type="submit" class="btn">Retirer du panier</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <div class="cart-summary">
        <p class="cart-total">Total : <strong>{{ totalInCents|cents_to_euros }}</strong></p>
        <div class="cart-actions">
            {% if items is not empty %}
                <form method="post" action="{{ path('app_checkout') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">
                    <button type="submit" class="btn btn-danger">Finaliser ma commande</button>
                </form>
            {% endif %}
            <a class="btn btn-success" href="{{ path('app_products') }}">Continuer mes achats</a>
        </div>
    </div>
{% endblock %}
