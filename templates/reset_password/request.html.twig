{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <div class="auth-box">
        <h1 class="auth-title">Mot de passe oublié</h1>
        <p>Saisissez l'adresse e-mail de votre compte : vous recevrez un lien pour choisir un nouveau mot de passe.</p>

        {{ form_start(requestForm) }}
            {{ form_row(requestForm.email) }}
            <button type="submit" class="btn btn-primary">Envoyer le lien</button>
        {{ form_end(requestForm) }}

        <p class="back-link"><a href="{{ path('app_login') }}">&larr; Retour à la connexion</a></p>
    </div>
{% endblock %}
