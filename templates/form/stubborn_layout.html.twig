{# Thème de formulaire de la boutique : chaque champ est enveloppé dans un bloc .form-row. #}
{% extends 'form_div_layout.html.twig' %}

{%- block form_row -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~ '_help'}} -%}
    {%- endif -%}
    <div class="form-row{% if errors|length > 0 %} has-error{% endif %}">
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row -%}

{%- block checkbox_row -%}
    <div class="form-row-checkbox-wrapper">
        <div class="form-row form-row-checkbox{% if errors|length > 0 %} has-error{% endif %}">
            {{- form_widget(form, help is not empty ? {attr: {'aria-describedby': id ~ '_help'}} : {}) -}}
            {{- form_label(form) -}}
            {{- form_errors(form) -}}
        </div>
        {{- form_help(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="hint">{{ help|trans(help_translation_parameters, translation_domain) }}</p>
    {%- endif -%}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="form-errors">
            {%- for error in errors -%}
                <li>{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}
